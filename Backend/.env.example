NODE_ENV=development
PORT=4500
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/cerateai
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key

