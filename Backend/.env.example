CLIENT_URL=http://localhost:5173
CLIENT_URLS=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional until you enable custom assistant image uploads.
CLOUD_NAME=
API_KEY=
API_SECRET=
